---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusBadges from '../components/StatusBadges.astro';
import StatBar from '../components/StatBar.astro';
import CredentialsGrid from '../components/CredentialsGrid.astro';
import CurrentProjects from '../components/CurrentProjects.astro';
import { projects, services } from '../data/site';
import { companyStats } from '../data/metrics';
---

<BaseLayout
  title="R&G Construction | Heavy Civil Contractor in Marshall, MN"
  description="R&G Construction delivers highway grading, utilities, reclamation and site development across Minnesota and South Dakota. Family owned since 1983."
>
  <section class="home-hero grain">
    {/* Custom concept image generated for this sample. Replace with R&G field photography before launch. */}
    <img class="hero-image" src="/images/rg-hero.png" alt="Heavy civil grading equipment shaping a rural Upper Midwest highway at sunset" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-grid grid-lines"></div>
    <div class="hero-rail"><span>Family owned since 1983</span><span>MN / SD</span></div>
    <div class="container-shell hero-content">
      <div class="hero-status"><StatusBadges /></div>
      <span class="eyebrow eyebrow-light">Marshall, Minnesota · Heavy Civil</span>
      <h1 class="display"><span>Built for</span><br /><em>the long haul.</em></h1>
      <div class="hero-copy">
        <p>40+ years of moving earth, building roads and delivering the infrastructure that keeps the Upper Midwest moving.</p>
        <div class="hero-actions">
          <a class="btn btn-orange btn-arrow" href="/contact#quote">Request a Quote</a>
          <a class="btn btn-outline" href="/projects">View Our Work</a>
        </div>
      </div>
    </div>
    <div class="scroll-mark"><span></span>Scroll to break ground</div>
  </section>

  <StatBar stats={companyStats} />

  <section class="section-pad intro-section">
    <div class="container-shell intro-grid reveal">
      <div>
        <span class="eyebrow">The R&G difference</span>
        <h2 class="display">Dirt is where<br />we do our <em>best work.</em></h2>
      </div>
      <div class="intro-copy">
        <p class="lead">We take on the work below every successful road, runway and development—the work that has to be right before anything else can be built.</p>
        <p>R&G Construction specializes in complete grading, shoulder widening, box culverts, bituminous reclamation, municipal utilities, site development and demolition. Projects range from a few thousand dollars to as much as $10 million.</p>
        <a class="text-link" href="/about">Get to know R&G <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="services-section">
    <div class="container-shell">
      <div class="section-heading reveal">
        <div><span class="eyebrow eyebrow-light">What we do</span><h2 class="display">Eight ways we<br /><em>move projects.</em></h2></div>
        <p>One experienced civil team, ready from first cut to final grade.</p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <a class="service-card reveal" href={`/services#${service.slug}`}>
            <span class="service-number">/{service.number}</span>
            <span class="service-icon" aria-hidden="true">↘</span>
            <h3 class="display">{service.title}</h3>
            <p>{service.short}</p>
            <span class="service-view">Explore service <b>↗</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tech-section angled-top grain">
    <div class="container-shell tech-grid">
      <div class="tech-visual reveal">
        {/* TODO: replace with real R&G GPS-equipped machine photo before launch */}
        <img src="/images/precision-grading.jpg" alt="Motor grader demonstrating precision heavy civil earthwork" loading="lazy" />
        <div class="gps-target"><span></span><span></span><span></span></div>
        <div class="tech-readout"><small>Machine control</small><strong>± 0.10'</strong><span>Design surface active</span></div>
      </div>
      <div class="tech-copy reveal">
        <span class="eyebrow">Rethinking construction</span>
        <h2 class="display">Precision<br />at full <em>scale.</em></h2>
        <p>State-of-the-art Trimble GPS systems put design surfaces directly in the cab. Operators see cut, fill and finish grade in real time—reducing staking, keeping production moving and getting the work right.</p>
        <div class="tech-points">
          <div><span>01</span><strong>Build stakeless</strong><p>Fewer survey stakes and faster field decisions.</p></div>
          <div><span>02</span><strong>Grade precisely</strong><p>Design data guides equipment to exact elevations.</p></div>
          <div><span>03</span><strong>Move efficiently</strong><p>Reduce rework across highways, sites and airfields.</p></div>
        </div>
        <a class="btn btn-orange btn-arrow" href="/about#technology">See how we work</a>
      </div>
    </div>
  </section>

  <section class="current-section section-pad">
    <div class="container-shell">
      <div class="current-heading reveal">
        <div><span class="eyebrow">Current projects</span><h2 class="display">In the dirt.<br /><em>Moving forward.</em></h2></div>
        <div class="current-note"><strong>Concept project feed</strong><p>These entries demonstrate a future CMS-managed project status area. Confirm active work and update monthly before launch.</p></div>
      </div>
      <CurrentProjects />
    </div>
  </section>

  <section class="section-pad projects-section">
    <div class="container-shell">
      <div class="light-heading reveal">
        <div><span class="eyebrow">Selected work</span><h2 class="display">Built here.<br /><em>Built to last.</em></h2></div>
        <div><p>Recent public work and long-standing experience across southwest Minnesota.</p><a class="text-link" href="/projects">View all projects <span>↗</span></a></div>
      </div>
      <div class="featured-grid">{projects.filter((p) => p.featured).map((project, index) => <ProjectCard project={project} index={index} />)}</div>
      <p class="imagery-note">Sample website imagery is representative. Project photography and final project details should be confirmed before launch.</p>
    </div>
  </section>

  <section class="partner-section">
    <div class="container-shell partner-inner reveal">
      <span class="partner-label">Proud industry members</span>
      <div class="partner-row">
        <div><strong>ABC</strong><span>Associated Builders<br />& Contractors</span></div>
        <div><strong>AGC</strong><span>Associated General<br />Contractors of Minnesota</span></div>
        <div><strong>MAPA</strong><span>MN Asphalt Pavement<br />Association</span></div>
        <div><strong>40+</strong><span>Years family owned<br />and operated</span></div>
      </div>
    </div>
  </section>

  <section class="credentials-section section-pad">
    <div class="container-shell">
      <div class="credentials-heading reveal"><div><span class="eyebrow">Bid-ready at a glance</span><h2 class="display">Credentials<br /><em>with clarity.</em></h2></div><p>Designed to give public and private owners a fast credential overview—while clearly flagging every status that still needs R&G verification.</p></div>
      <CredentialsGrid compact />
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; height: max(760px, 100svh); min-height: 760px; display: flex; align-items: flex-end; overflow: hidden; background: var(--graphite); color: var(--bone); }
  .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; animation: hero-in 1.4s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes hero-in { from { transform: scale(1.07); opacity: .4; } to { transform: scale(1); opacity: 1; } }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(27,31,28,.96) 0%, rgba(27,31,28,.78) 46%, rgba(27,31,28,.09) 80%), linear-gradient(0deg, rgba(20,23,21,.62) 0%, transparent 48%); }
  .hero-grid { position: absolute; inset: 0; opacity: .36; background-image: linear-gradient(rgba(238,233,223,.09) 1px, transparent 1px), linear-gradient(90deg, rgba(238,233,223,.09) 1px, transparent 1px); }
  .hero-rail { position: absolute; z-index: 2; top: 50%; right: -6.5rem; display: flex; gap: 2rem; color: rgba(238,233,223,.62); font-size: .58rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; transform: rotate(90deg); }
  .hero-content { position: relative; z-index: 2; padding-bottom: 6.5rem; }
  .hero-status { margin-bottom: 1.4rem; }
  .hero-content h1 { margin: 1.25rem 0 1.7rem; font-size: clamp(5.5rem, 12vw, 11.5rem); }
  .hero-content h1 span { color: var(--bone); }
  .hero-content h1 em { color: var(--yellow); font-style: italic; font-weight: 800; }
  .hero-copy { display: grid; grid-template-columns: minmax(0, 560px) auto; align-items: end; gap: 3rem; }
  .hero-copy p { margin: 0; color: #d0ccc3; font-size: clamp(1rem, 1.5vw, 1.22rem); line-height: 1.65; }
  .hero-actions { display: flex; gap: .8rem; }
  .scroll-mark { position: absolute; z-index: 2; right: 2.5rem; bottom: 2rem; display: flex; align-items: center; gap: .75rem; color: rgba(238,233,223,.55); font-size: .57rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .scroll-mark span { width: 2.5rem; height: 1px; background: var(--yellow); }
  .intro-section { background: var(--paper); }
  .intro-grid { display: grid; grid-template-columns: 1.08fr .72fr; gap: 7rem; align-items: start; }
  .intro-grid h2, .section-heading h2, .light-heading h2 { margin: 1.3rem 0 0; font-size: clamp(4.3rem, 8vw, 8.5rem); }
  .intro-grid h2 em, .light-heading h2 em { color: var(--yellow-deep); font-style: italic; }
  .intro-copy { padding-top: 3.4rem; }
  .intro-copy p { color: #626660; line-height: 1.8; }
  .intro-copy .lead { color: var(--ink); font-size: 1.25rem; line-height: 1.55; }
  .text-link { display: inline-flex; align-items: center; gap: .75rem; margin-top: 1rem; border-bottom: 2px solid var(--yellow-deep); padding-bottom: .45rem; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .text-link span { color: var(--yellow-deep); }
  .services-section { padding-block: 7.5rem; background: #242825; color: var(--bone); border-block: 1px solid #3b403c; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 3rem; margin-bottom: 4rem; }
  .section-heading h2 em { color: var(--yellow-deep); font-style: italic; }
  .section-heading > p { max-width: 260px; margin: 0 0 .4rem; color: #aaa79e; font-size: .88rem; line-height: 1.6; }
  .service-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #474c48; border-left: 1px solid #474c48; }
  .service-card { position: relative; min-height: 365px; display: flex; flex-direction: column; border-right: 1px solid #474c48; border-bottom: 1px solid #474c48; padding: 1.7rem; overflow: hidden; transition: background .3s, color .3s; }
  .service-card::before { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 4px; background: var(--yellow); transform: scaleX(0); transform-origin: left; transition: transform .35s; }
  .service-card:hover { background: #303531; }
  .service-card:hover::before { transform: scaleX(1); }
  .service-number { color: #777b76; font-family: var(--display); font-size: .9rem; }
  .service-icon { margin-left: auto; color: #747972; font-size: 2rem; transition: color .2s, transform .2s; }
  .service-card:hover .service-icon { color: var(--yellow); transform: translate(4px, 4px); }
  .service-card h3 { max-width: 240px; margin: 4.4rem 0 1rem; font-size: 2.55rem; }
  .service-card p { margin: 0; color: #aaa79e; font-size: .76rem; line-height: 1.65; }
  .service-view { margin-top: auto; padding-top: 1.5rem; color: #c4c0b7; font-size: .6rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .service-view b { float: right; color: var(--yellow); font-size: .9rem; }
  .tech-section { background: #bfb7a9; color: var(--ink); }
  .tech-grid { display: grid; grid-template-columns: 1fr .9fr; gap: 7rem; align-items: center; padding-bottom: 8rem; }
  .tech-visual { position: relative; min-height: 690px; }
  .tech-visual img { width: 100%; height: 100%; min-height: 690px; object-fit: cover; filter: saturate(.65) contrast(1.08); }
  .tech-visual::after { content: ''; position: absolute; inset: 0; border: 1px solid rgba(20,22,21,.2); box-shadow: inset 0 0 90px rgba(0,0,0,.22); }
  .gps-target { position: absolute; z-index: 2; left: 61%; top: 56%; width: 96px; height: 96px; border: 1px solid var(--yellow); border-radius: 50%; }
  .gps-target::before, .gps-target::after { content: ''; position: absolute; background: var(--orange); }
  .gps-target::before { width: 130%; height: 1px; top: 50%; left: -15%; }
  .gps-target::after { height: 130%; width: 1px; left: 50%; top: -15%; }
  .gps-target span { position: absolute; inset: 12px; border: 1px solid rgba(240,217,0,.7); border-radius: 50%; }
  .tech-readout { position: absolute; z-index: 3; right: -2.5rem; bottom: 3rem; min-width: 210px; display: flex; flex-direction: column; background: var(--yellow); padding: 1.25rem; color: var(--ink); }
  .tech-readout small, .tech-readout span { font-size: .56rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .tech-readout strong { margin-block: .35rem; font-family: var(--display); font-size: 2.8rem; line-height: 1; }
  .tech-copy h2 { margin: 1.4rem 0 1.5rem; font-size: clamp(4.5rem, 7vw, 7.6rem); }
  .tech-copy h2 em { color: var(--yellow-deep); font-style: italic; }
  .tech-copy > p { color: #626660; line-height: 1.8; }
  .tech-points { margin: 2.3rem 0; border-top: 1px solid rgba(20,22,21,.17); }
  .tech-points > div { display: grid; grid-template-columns: 40px 1fr; border-bottom: 1px solid rgba(20,22,21,.17); padding-block: 1rem; }
  .tech-points span { grid-row: span 2; color: var(--yellow-deep); font-family: var(--display); font-weight: 700; }
  .tech-points strong { font-family: var(--display); font-size: 1.2rem; letter-spacing: .02em; text-transform: uppercase; }
  .tech-points p { margin: .2rem 0 0; color: #727670; font-size: .72rem; }
  .current-section { background: #cec6b8; border-top: 1px solid #b6ad9e; }
  .current-heading, .credentials-heading { display: flex; justify-content: space-between; align-items: end; gap: 4rem; margin-bottom: 3rem; }
  .current-heading h2, .credentials-heading h2 { margin: 1.2rem 0 0; font-size: clamp(4rem,7.5vw,7.6rem); }
  .current-heading h2 em, .credentials-heading h2 em { color: var(--yellow-deep); font-style: italic; }
  .current-note, .credentials-heading > p { max-width: 390px; border-left: 4px solid var(--yellow); padding-left: 1rem; }
  .current-note strong { font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; }
  .current-note p, .credentials-heading > p { margin: .55rem 0 0; color: #6c706a; font-size: .75rem; line-height: 1.6; }
  .projects-section { background: #d8d1c4; }
  .light-heading { display: flex; justify-content: space-between; align-items: end; gap: 3rem; margin-bottom: 3.5rem; }
  .light-heading > div:last-child { max-width: 320px; padding-bottom: .6rem; }
  .light-heading p { color: #666a64; font-size: .86rem; line-height: 1.6; }
  .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .imagery-note { margin: 1rem 0 0; color: #92958f; font-size: .62rem; font-style: italic; }
  .partner-section { background: #bcb4a6; }
  .partner-inner { padding-block: 4rem; }
  .partner-label { display: block; margin-bottom: 2rem; color: #757872; font-size: .62rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .partner-row { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #bcb7ad; border-left: 1px solid #bcb7ad; }
  .partner-row > div { min-height: 115px; display: flex; align-items: center; gap: 1rem; border-right: 1px solid #bcb7ad; border-bottom: 1px solid #bcb7ad; padding: 1.4rem; }
  .partner-row strong { font-family: var(--display); font-size: 2rem; }
  .partner-row span { color: #73766f; font-size: .63rem; font-weight: 700; letter-spacing: .04em; line-height: 1.35; text-transform: uppercase; }
  .credentials-section { background: #222624; color: var(--bone); }
  .credentials-section .eyebrow { color: var(--yellow); }
  .credentials-section .credentials-heading h2 em { color: var(--yellow); }
  .credentials-heading > p { color: #aaa79e; }
  .services-section .section-heading h2 em { color: var(--yellow); }
  @media (max-width: 1050px) { .hero-copy { grid-template-columns: 1fr; } .hero-actions { justify-content: flex-start; } .stat-grid { grid-template-columns: 1fr 1fr; } .intro-grid, .tech-grid { gap: 3.5rem; } .service-grid { grid-template-columns: repeat(2, 1fr); } .featured-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 780px) { .home-hero { min-height: 720px; } .hero-content { padding-bottom: 5rem; } .hero-rail, .scroll-mark { display: none; } .hero-actions { flex-wrap: wrap; } .intro-grid, .tech-grid { grid-template-columns: 1fr; } .intro-copy { padding-top: 0; } .section-heading, .light-heading, .current-heading, .credentials-heading { align-items: start; flex-direction: column; } .tech-grid { padding-bottom: 6rem; } .tech-visual, .tech-visual img { min-height: 480px; } .tech-readout { right: 1rem; } .featured-grid { grid-template-columns: 1fr; } .partner-row { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 530px) { .hero-content h1 { font-size: 4.7rem; } .service-grid { grid-template-columns: 1fr; } .service-card { min-height: 320px; } .partner-row { grid-template-columns: 1fr; } }
</style>
