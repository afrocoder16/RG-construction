---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  number: string;
  image?: string;
}
const { eyebrow, title, intro, number, image = '/images/rg-hero.png' } = Astro.props;
---

<section class="page-hero" style={`--hero-image: url('${image}')`}>
  <div class="page-overlay"></div>
  <div class="page-grid grid-lines"></div>
  <div class="container-shell page-content">
    <div>
      <span class="eyebrow eyebrow-light">{eyebrow}</span>
      <h1 class="display">{title}</h1>
      <p>{intro}</p>
    </div>
    <span class="page-number">/{number}</span>
  </div>
  <div class="page-strip"><div class="container-shell"><span>Marshall, MN</span><span>44.4484° N / 95.7912° W</span></div></div>
</section>

<style>
  .page-hero { position: relative; min-height: 640px; display: flex; align-items: flex-end; overflow: hidden; background: var(--graphite) var(--hero-image) center/cover no-repeat; color: var(--bone); }
  .page-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(27,31,28,.97) 0%, rgba(27,31,28,.87) 43%, rgba(27,31,28,.28) 82%), linear-gradient(0deg, rgba(27,31,28,.78), transparent 58%); }
  .page-grid { position: absolute; inset: 0; opacity: .55; background-image: linear-gradient(rgba(238,233,223,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(238,233,223,.08) 1px, transparent 1px); }
  .page-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-end; gap: 3rem; padding: 12rem 0 6.5rem; }
  .page-content > div { max-width: 850px; }
  h1 { max-width: 920px; margin: 1.2rem 0 1.5rem; font-size: clamp(4.2rem, 10vw, 9.5rem); }
  p { max-width: 650px; margin: 0; color: #c8c4bb; font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.65; }
  .page-number { color: rgba(238,233,223,.18); font-family: var(--display); font-size: 6rem; font-weight: 700; line-height: .8; }
  .page-strip { position: absolute; z-index: 2; inset: auto 0 0; border-top: 1px solid rgba(238,233,223,.15); background: rgba(26,30,27,.72); }
  .page-strip > div { display: flex; justify-content: space-between; padding-block: 1rem; color: #aaa69d; font-size: .61rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  @media (max-width: 700px) { .page-hero { min-height: 560px; } .page-content { padding-top: 9rem; padding-bottom: 5.5rem; } .page-number { display: none; } }
</style>
