---
import { credentials } from '../data/metrics';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

{/* LEGAL PLACEHOLDER: Verify every bonding, certification, prequalification, and DBE claim directly with R&G before launch. */}
<div class:list={['credentials-grid', { compact }]}>
  {credentials.map((credential) => (
    <article>
      <div class="credential-top"><span class="credential-mark">{credential.mark}</span><small class:list={{ verified: credential.verified }}>{credential.verified ? 'Stated status' : 'Needs confirmation'}</small></div>
      <h3 class="display">{credential.label}</h3>
      <strong>{credential.value}</strong>
      <p>{credential.note}</p>
    </article>
  ))}
</div>

<style>
  .credentials-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); border-top: 1px solid #474c48; border-left: 1px solid #474c48; color: var(--bone); }
  article { min-height: 245px; display: flex; flex-direction: column; border-right: 1px solid #474c48; border-bottom: 1px solid #474c48; background: #2c312e; padding: 1.3rem; }
  .credential-top { display: flex; align-items: center; justify-content: space-between; gap: .7rem; }
  .credential-mark { display: grid; place-items: center; width: 48px; height: 48px; border: 2px solid var(--yellow-deep); border-radius: 50%; color: var(--yellow-deep); font-family: var(--display); font-size: 1.15rem; font-weight: 800; }
  .credential-top small { border: 1px solid #d5a94a; background: #fff3d5; padding: .3rem .4rem; color: #785713; font-size: .48rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .credential-top small.verified { border-color: #75a883; background: #edf7ef; color: #2e693e; }
  h3 { margin: 2.7rem 0 .3rem; font-size: 1.7rem; }
  article > strong { font-size: .68rem; letter-spacing: .07em; text-transform: uppercase; }
  p { margin: .65rem 0 0; color: #aaa79f; font-size: .65rem; line-height: 1.5; }
  .compact article { min-height: 220px; }
  @media (max-width: 1050px) { .credentials-grid { grid-template-columns: repeat(3,1fr); } }
  @media (max-width: 680px) { .credentials-grid { grid-template-columns: 1fr; } article { min-height: 210px; } }
</style>
