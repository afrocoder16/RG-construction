---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/rg-hero.png' } = Astro.props;
const publicImage = withBase(image);
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: 'R&G Construction Co.',
  url: siteRoot.href,
  telephone: '+1-507-537-1473',
  email: 'info@randgconstruction.com',
  foundingDate: '1983',
  image: new URL(publicImage, Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2694 County Road 6',
    addressLocality: 'Marshall',
    addressRegion: 'MN',
    postalCode: '56258',
    addressCountry: 'US',
  },
  areaServed: ['Minnesota', 'South Dakota'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101212" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/images/logo.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(publicImage, Astro.site)} />
    <meta property="og:type" content="website" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: .12 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  .skip-link { position: fixed; z-index: 999; left: 1rem; top: -5rem; background: white; color: #101212; padding: .8rem 1rem; font-weight: 700; }
  .skip-link:focus { top: 1rem; }
</style>
